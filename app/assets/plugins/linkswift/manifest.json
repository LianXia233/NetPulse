{
  "id": "linkswift",
  "identity": "hmjz100@linkswift",
  "name": "LinkSwift 网盘直链",
  "version": "1.1.3",
  "description": "在内置浏览器里跑起 LinkSwift：百度、阿里、移动、天翼、迅雷、夸克、UC、123 等网盘的分享页会多出直链入口，解析出的地址直接交给 NetPulse 多线程下载，并按网盘自动补齐 Referer、User-Agent 与 Cookie。",
  "homepage": "https://github.com/hmjz100/LinkSwift",
  "license": "AGPL-3.0-or-later",
  "match": [],
  "pageScripts": [
    {
      "id": "pan-download",
      "matches": [
        "*://pan.baidu.com/*",
        "*://yun.baidu.com/*",
        "*://www.aliyundrive.com/*",
        "*://www.alipan.com/*",
        "*://yun.139.com/*",
        "*://caiyun.139.com/*",
        "*://cloud.189.cn/*",
        "*://pan.xunlei.com/*",
        "*://pan.quark.cn/*",
        "*://drive.uc.cn/*",
        "*://*.123pan.com/*",
        "*://*.123pan.cn/*",
        "*://*.123684.com/*",
        "*://*.123865.com/*",
        "*://*.123952.com/*",
        "*://*.123912.com/*"
      ],
      "js": [
        [
          "vendor/preload.js",
          "vendor/jquery.min.js",
          "vendor/sweetalert2.min.js",
          "vendor/md5.min.js",
          "vendor/sha256.js",
          "gm-shim.js"
        ],
        ["linkswift.js"],
        ["netpulse-bridge.js"]
      ],
      "resources": {
        "SwalLigt": "vendor/sweetalert2.min.css",
        "SwalDark": "vendor/sweetalert2-dark.min.css"
      },
      "runAt": "document_idle"
    }
  ]
}
