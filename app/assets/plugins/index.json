[
  {
    "id": "m3u8-pro",
    "identity": "community@m3u8-pro",
    "name": "M3U8 超级下载器 Pro",
    "version": "1.0.0",
    "description": "把 M3U8 主播放列表交给 NetPulse 引擎：列出全部清晰度、按偏好预选、用网页标题命名、自动补 Referer/UA，并识别独立音轨、AES-128 与直播列表。",
    "homepage": "https://github.com/Ouyangyouzi/fluxdown-m3u8-pro",
    "match": [
      "*m3u8*"
    ],
    "entry": "resolve.js",
    "timeoutMs": 20000,
    "settings": [
      {
        "key": "maxHeight",
        "title": "默认清晰度上限",
        "description": "画质选择框的默认选项。best = 最高码率；其余按不超过该高度的最高一档，没有更低的就取最低档。",
        "type": "string",
        "widget": "select",
        "options": [
          {
            "value": "best",
            "label": "最高（best）"
          },
          {
            "value": "2160",
            "label": "2160p / 4K"
          },
          {
            "value": "1440",
            "label": "1440p / 2K"
          },
          {
            "value": "1080",
            "label": "1080p"
          },
          {
            "value": "720",
            "label": "720p"
          },
          {
            "value": "480",
            "label": "480p"
          },
          {
            "value": "360",
            "label": "360p"
          }
        ],
        "default": "1080"
      },
      {
        "key": "container",
        "title": "文件名扩展名",
        "description": "auto = 主列表按 mp4、媒体列表按是否含 EXT-X-MAP 判断（fMP4 → mp4，TS → ts）。实际容器由 NetPulse 引擎决定，若扩展名不符请改这里。",
        "type": "string",
        "widget": "select",
        "options": [
          {
            "value": "auto",
            "label": "自动判断"
          },
          {
            "value": "mp4",
            "label": "mp4"
          },
          {
            "value": "ts",
            "label": "ts"
          },
          {
            "value": "mkv",
            "label": "mkv"
          }
        ],
        "default": "auto"
      },
      {
        "key": "nameSource",
        "title": "文件名来源",
        "description": "referrer = 网页地址（任务携带的 Referer）的最后一段；playlist = 播放列表文件名；none = 不干预命名。",
        "type": "string",
        "widget": "select",
        "options": [
          {
            "value": "referrer",
            "label": "网页地址（推荐）"
          },
          {
            "value": "playlist",
            "label": "播放列表文件名"
          },
          {
            "value": "none",
            "label": "不干预"
          }
        ],
        "default": "referrer"
      },
      {
        "key": "injectHeaders",
        "title": "补齐 Referer / User-Agent",
        "description": "任务没有携带 Referer 或 UA 时，用任务里记录的那份补上，适合防盗链 CDN。已有同名请求头不会被覆盖。",
        "type": "boolean",
        "default": "true"
      },
      {
        "key": "injectOrigin",
        "title": "补发 Origin",
        "description": "只有 CDN 明确要求 Origin 时才打开；部分签名地址带上 Origin 反而会被拒。",
        "type": "boolean",
        "default": "false"
      },
      {
        "key": "attachAudio",
        "title": "分离音轨一并交给引擎（实验性）",
        "description": "主列表用 EXT-X-MEDIA 把音频单独成轨时，把音轨地址作为 audioUrl 返回；NetPulse 会另建一个音频下载任务，不做自动合并。部分站点会让音画不同步，默认关闭。",
        "type": "boolean",
        "default": "false"
      }
    ]
  },
  {
    "id": "github-accel",
    "identity": "fluxdown@github-accel",
    "name": "GitHub 加速",
    "version": "1.0.0",
    "description": "GitHub 文件下载自动加速：解析前对本次要下载的文件在各加速源上并行实测（Range 采样 64 KB），一次探测同时验证可用性与速度，选最快的改写直链；全部不可用则自动回退 GitHub 直连，加速失败绝不阻断下载。内置两个加速源——jsDelivr CDN（fastly.jsdelivr.net/gh，仅支持仓库内 blob/raw 文件、单文件 ≤ 20 MB，不支持 release 资产与源码归档）与 FastGit（fastgit.cc，hunshcn/gh-proxy 部署，release 资产 / archive 源码包 / 分支文件全类型）。覆盖 github.com（releases/download、archive、blob、raw）、raw.githubusercontent.com 与 gist.githubusercontent.com 链接。探测到 206 时回填 Range 支持让引擎直接多线程分段；同一链接会记住上次选中的源，续传恢复不换源。可在设置中固定加速源或直连，也可按行添加更多 gh-proxy 风格加速源参与测速，无需改代码即可扩展。",
    "homepage": "https://github.com/zerx-lab/fluxdown-plugin-github-accel",
    "match": [
      "*://github.com/*",
      "*://www.github.com/*",
      "*://raw.githubusercontent.com/*",
      "*://gist.githubusercontent.com/*"
    ],
    "entry": "resolve.js",
    "timeoutMs": 25000,
    "settings": [
      {
        "key": "preferred",
        "title": "加速源",
        "description": "自动 = 每次下载前并行测速，选最快且可用的源；固定某源后若其不可用仍会回退到其他可用源",
        "type": "string",
        "widget": "select",
        "options": [
          {
            "value": "auto",
            "label": "自动（测速优选）"
          },
          {
            "value": "jsdelivr",
            "label": "jsDelivr CDN"
          },
          {
            "value": "fastgit",
            "label": "FastGit（gh-proxy）"
          },
          {
            "value": "direct",
            "label": "直连（禁用加速）"
          }
        ],
        "default": "auto"
      },
      {
        "key": "extraProxies",
        "title": "附加 gh-proxy 加速源",
        "description": "每行一个 https:// 前缀（gh-proxy 风格，完整 GitHub 链接直接拼在其后），自动参与测速，例如 https://ghproxy.net/",
        "type": "string",
        "widget": "textarea",
        "default": ""
      },
      {
        "key": "verbose",
        "title": "详细日志",
        "description": "记录每个加速源的探测结果（状态码与耗时）",
        "type": "boolean",
        "widget": "toggle",
        "default": "false"
      }
    ]
  },
  {
    "id": "quark-share",
    "identity": "myderr@quark-share",
    "name": "Quark Share Resolver",
    "version": "0.2.2",
    "description": "浏览夸克网盘分享目录，选择所需文件后转存到指定目录并返回临时下载直链，完成后自动清理。",
    "homepage": "https://github.com/myderr/fluxdown-quark-share",
    "match": [
      "*://pan.quark.cn/s/*"
    ],
    "entry": "resolver.js",
    "timeoutMs": 30000,
    "settings": [
      {
        "key": "cookie",
        "title": "夸克网盘 Cookie",
        "description": "粘贴 pan.quark.cn 登录后的完整 Cookie（支持多行长文本）。解析、转存和清理统一使用此账号。",
        "type": "string",
        "widget": "textarea",
        "required": true,
        "localizations": {
          "zh": {
            "title": "夸克网盘 Cookie",
            "description": "粘贴 pan.quark.cn 登录后的完整 Cookie（支持多行长文本）。解析、转存和清理统一使用此账号。"
          },
          "en": {
            "title": "Quark Drive Cookie",
            "description": "Paste the full Cookie from your signed-in pan.quark.cn session. Multiple lines are supported. This account is used to resolve links, save files, and clean up temporary copies."
          }
        }
      },
      {
        "key": "targetFolderId",
        "title": "目标目录 ID",
        "description": "开始转存前需填写预先创建的目标目录 fid，根目录为 0。",
        "type": "string",
        "widget": "text",
        "pattern": "^[A-Za-z0-9_-]+$",
        "required": false,
        "localizations": {
          "zh": {
            "title": "目标目录 ID",
            "description": "开始转存前需填写预先创建的目标目录 fid，根目录为 0。"
          },
          "en": {
            "title": "Destination folder ID",
            "description": "Enter the fid of an existing Quark folder before saving files. Use 0 for the root folder."
          }
        }
      },
      {
        "key": "maxFiles",
        "title": "最多列出文件数",
        "description": "预览时最多列出当前分享目录中的多少个直属文件，不递归子文件夹。",
        "type": "number",
        "widget": "number",
        "min": 1,
        "max": 1000,
        "default": "200",
        "required": true,
        "localizations": {
          "zh": {
            "title": "最多列出文件数",
            "description": "预览时最多列出当前分享目录中的多少个直属文件，不递归子文件夹。"
          },
          "en": {
            "title": "Maximum files to display",
            "description": "Limit the number of files shown from the current shared folder. Subfolders are not scanned recursively."
          }
        }
      },
      {
        "key": "cleanupIntervalHours",
        "title": "后台清理间隔（小时）",
        "description": "定期清理失败或被取消后残留的夸克临时转存文件。",
        "type": "number",
        "widget": "number",
        "min": 1,
        "max": 168,
        "default": "6",
        "required": true,
        "localizations": {
          "zh": {
            "title": "后台清理间隔（小时）",
            "description": "定期清理失败或被取消后残留的夸克临时转存文件。"
          },
          "en": {
            "title": "Background cleanup interval (hours)",
            "description": "How often to check for temporary Quark copies left behind by failed or canceled downloads."
          }
        }
      }
    ],
    "pageScripts": [
      {
        "id": "share-download",
        "matches": [
          "https://pan.quark.cn/s/*"
        ],
        "js": [
          "page-download.js"
        ],
        "runAt": "document_idle"
      }
    ]
  },
